# Ambientes virtuais Python — cada aula tem seu próprio requirements.txt;
# o ambiente é criado localmente, nunca versionado.
.venv/
**/.venv/
__pycache__/
**/__pycache__/
*.pyc

# Bancos SQLite gerados em execução/teste — cada serviço cria o seu.
*.db
*.db-journal
*.db-wal
*.db-shm

# Caches de teste
.pytest_cache/
**/.pytest_cache/
.coverage
htmlcov/

# Segredos locais — cada aula que precisar traz um .env.example versionado.
.env
**/.env
!**/.env.example
